# Copy to .env and fill in as needed. .env is excluded from version control.

# Only needed when the weather provider is set to OpenWeatherMap.
# Open-Meteo (the default) requires no key.
OPENWEATHER_API_KEY=

# Path to the Gemma 2B GGUF file (overrides the path set in the dashboard).
# Relative paths are resolved from the project folder.
APLOS_MODEL_PATH=models/gemma-2-2b-it-Q4_K_M.gguf

# Optional storage locations (defaults: data/aplos.db and logs/).
# APLOS_DB_PATH=data/aplos.db
# APLOS_LOG_DIR=logs
# APLOS_LOG_LEVEL=INFO
